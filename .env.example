# ATL-Trust Zero-Trust AI Agent Validation Platform - Environment Configuration

# Validation Mode: "rules" (default, Rust baseline checks), "grok" (always call Grok), "hybrid" (rules first, Grok on high-risk/uncertain calls)
ATL_TRUST_VALIDATOR=rules

# xAI / Grok API Configuration
XAI_API_KEY=xai-your-api-key-here
GROK_MODEL=grok-4.6
GROK_TIMEOUT_SECONDS=8
GROK_FAIL_MODE=deny  # Options: "deny" (fail-closed), "allow" (fail-open), "require_human", "rules"

# ATL-Trust Rust PEP Microservice Endpoint
ATL_TRUST_CORE_URL=http://localhost:3000
